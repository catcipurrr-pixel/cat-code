# ---- Cat Code site configuration (all optional; defaults live in src/config.ts) ----

# Server-side (NOT exposed to the browser): upstream RPCs used by the built-in /api/rpc proxy.
# Use a paid RPC (Helius, Triton, QuickNode...) in production; the public endpoint rejects browser origins
# and is heavily rate-limited.
RPC_UPSTREAM_URL=https://api.mainnet-beta.solana.com

# Browser RPC. Leave unset to use the proxy (/api/rpc/main). Or set a full https URL that allows browser origins.
NEXT_PUBLIC_RPC_URL=
# Cluster label for explorer links: mainnet-beta | devnet | localnet
NEXT_PUBLIC_CLUSTER=mainnet-beta
# Deployed program ID (defaults to the address in src/idl/cat_code.json)
NEXT_PUBLIC_PROGRAM_ID=
# Countdown target used until an on-chain round exists (ISO 8601 with offset, or unix seconds)
NEXT_PUBLIC_FALLBACK_COUNTDOWN_TARGET=2026-10-01T02:00:00-04:00
# Where unlocked cipher files live. {id} is replaced by the round id. Upload the file AT unlock time.
NEXT_PUBLIC_CIPHER_URL_TEMPLATE=/puzzles/round-{id}.json
# Public site URL (for OpenGraph image URLs)
NEXT_PUBLIC_SITE_URL=
